EMERALD_ENVIRONMENT=demo
EMERALD_ALLOW_REAL_TRADING=false
EMERALD_API_TOKEN=replace-with-openssl-rand-hex-32
EMERALD_JOURNAL_PATH=/var/lib/riri-emerald/emerald.db
EMERALD_EXPECTED_ACCOUNT_SERVER=MetaQuotes-Demo
EMERALD_EXPECTED_SYMBOL=XAUUSD
EMERALD_EXPECTED_LEVERAGE=200
EMERALD_PROBABILITY_MODEL_READY=false
EMERALD_EXECUTOR_HEARTBEAT_MAX_AGE_SECONDS=10
EMERALD_TICK_STREAM_MAX_AGE_SECONDS=5
EMERALD_MINIMUM_CALIBRATION_SAMPLES_PER_MODE=100
EMERALD_SPECIAL_MINIMUM_CALIBRATION_SAMPLES=20
EMERALD_NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
EMERALD_NEWS_CALENDAR_REFRESH_SECONDS=300
EMERALD_NEWS_CALENDAR_TIMEOUT_SECONDS=3
EMERALD_NEWS_WINDOW_BEFORE_MINUTES=10
EMERALD_NEWS_WINDOW_AFTER_MINUTES=45
EMERALD_ROLLOVER_WINDOW_START_MINUTE_WIB=240
EMERALD_ROLLOVER_WINDOW_END_MINUTE_WIB=300
EMERALD_EXPLORATORY_SHADOW_ENABLED=true
EMERALD_EXPOSE_API_DOCS=false
EMERALD_TRUSTED_HOSTS=api-emerald.albiagent.com,127.0.0.1,localhost
